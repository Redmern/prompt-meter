{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/prompt-submit.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/stop.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modules": [
    "./pane.mjs"
  ]
}
